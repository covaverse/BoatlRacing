(fn UpdateDriveState_0 (DeltaSeconds)
  (Variables|Default|SetThrottle 0.0)
  (Variables|Default|SetSteeringTargetDegrees 0.0)
  (Variables|Default|SetTrimTargetDegrees 0.0)
  (Variables|Default|SetClutchHeld false)
  (if (Variables|Default|GetUseTestInput)
    (Variables|Default|SetThrottle (Variables|Default|GetTestThrottle))
    (Variables|Default|SetSteeringTargetDegrees (Variables|Default|GetTestSteeringDegrees))
    (Variables|Default|SetClutchHeld (Variables|Default|GetTestClutchHeld))
    (else
      (if (Pawn|IsLocallyControlled self)
        (bind owner (Game|GetPlayerController 0))
        (bind w (Game|Player|IsInputKeyDown owner "W"))
        (bind s (Game|Player|IsInputKeyDown owner "S"))
        (bind a (Game|Player|IsInputKeyDown owner "A"))
        (bind d (Game|Player|IsInputKeyDown owner "D"))
        (bind q (Game|Player|IsInputKeyDown owner "Q"))
        (bind e (Game|Player|IsInputKeyDown owner "E"))
        (bind clutch (Game|Player|IsInputKeyDown owner "SpaceBar"))
        (Variables|Default|SetThrottle (select w 1.0 (select s -0.4 0.0)))
        (Variables|Default|SetSteeringTargetDegrees (select d -18.0 (select a 18.0 0.0)))
        (Variables|Default|SetTrimTargetDegrees (select e 14.0 (select q -10.0 0.0)))
        (Variables|Default|SetClutchHeld clutch))))
  (bind throttle (Variables|Default|GetThrottle))
  (if (!= throttle 0.0)
    (Variables|Default|SetEngineStarted true))
  (bind targetrpm (select (Variables|Default|GetEngineStarted)
    (+ 900.0 (* (select (< throttle 0.0) (- throttle) throttle)
       (select (Variables|Default|GetClutchHeld) 5600.0 4700.0)))
    0.0))
  (Variables|Default|SetEngineRPM
    (Math|Interpolation|FInterpTo (Variables|Default|GetEngineRPM) targetrpm DeltaSeconds 2.5))
  (Variables|Default|SetClutchEngagement
    (Math|Interpolation|FInterpTo
      (Variables|Default|GetClutchEngagement)
      (select (Variables|Default|GetClutchHeld) 0.0 1.0)
      DeltaSeconds
      (select (Variables|Default|GetClutchHeld) 8.0 4.0)))
  (Variables|Default|SetBoatSpeed
    (Math|Vector|VectorLength (Transformation|GetComponentVelocity (Variables|Default|GetStaticMesh)))))
