(fn ConfigureBoatMass ()
  (bind _enginemasskg (Variables|Default|GetEngineMassKg))
  (bind _hullmasskg (Variables|Default|GetHullMassKg))
  (bind _returnvalue (+ _hullmasskg _enginemasskg))
  (bind _staticmesh (Variables|Default|GetStaticMesh))
  (Niagara|SetNiagaraSystemAsset :self (Variables|Default|GetPropWashFX)
    :InAsset "/Game/Boats/ThaiLongtail/FX/NS_LongtailPropWash.NS_LongtailPropWash"
    :bResetExistingOverrideParameters false)
  (Components|Activation|Deactivate (Variables|Default|GetWakeFX))
  (Components|Activation|Deactivate (Variables|Default|GetPropWashFX))
  (Niagara|SetNiagaraSystemAsset :self (Variables|Default|GetBowSplashFX)
    :InAsset "/Game/Boats/ThaiLongtail/FX/NS_LongtailBowSplash.NS_LongtailBowSplash"
    :bResetExistingOverrideParameters false)
  (Niagara|SetNiagaraVariable(Float) :self (Variables|Default|GetBowSplashFX)
    :InVariableName "User.SpawnRate" :InValue 0.0)
  (Niagara|SetNiagaraVariable(Float) :self (Variables|Default|GetPropSprayFX)
    :InVariableName "User.SpawnRate" :InValue 0.0)
  (Rendering|SetVisibility (Variables|Default|GetBowSplashFX) false false)
  (Rendering|SetVisibility (Variables|Default|GetPropSprayFX) false false)
  (Rendering|SetVisibility (Variables|Default|GetExhaustFX) false false)
  (Components|Activation|Activate (Variables|Default|GetBowSplashFX) true)
  (Components|Activation|Activate (Variables|Default|GetPropSprayFX) true)
  (Rendering|SetRenderInMainPass _staticmesh false)
  (Rendering|SetRenderInDepthPass _staticmesh false)
  (Rendering|SetVisibleInRayTracing _staticmesh false)
  (Development|SetHiddenInGame _staticmesh false false)
  (CallFunction|LoadHandlingProfile)
  (if (> _returnvalue 1.0)
    (Physics|SetMassOverrideInKg _staticmesh "None" _returnvalue)
    (Physics|SetCenterOfMass _staticmesh (Math|Vector|MakeVector (- (/ (+ (* _hullmasskg (Variables|Default|GetHullCenterX)) (* _enginemasskg (Variables|Default|GetEngineCenterX))) _returnvalue) 75.7777778) 0.0 (- (Variables|Default|GetCenterZ) 5.0)))
    (bind _returnvalue_1 (Boat|Water|SetHullPontoonRadii (Variables|Default|GetBuoyancy) (Variables|Default|GetFrontPontoonRadiusCm) (Variables|Default|GetRearPontoonRadiusCm)))
    (if (not _returnvalue_1)
      (Development|PrintString "WARNING Boat pontoon setup rejected; check component BeginPlay and handling radii"))))

