(fn LoadHandlingProfile ()
  (bind profile (Variables|Default|GetHandlingProfile))
  (Utilities|IsValid profile
    (:"Is Valid"
      (bind vHullMassKg (Class|BPBoatHandlingData|GetHullMassKg :self profile))
      (bind vEngineMassKg (Class|BPBoatHandlingData|GetEngineMassKg :self profile))
      (bind vHullCenterXcm (Class|BPBoatHandlingData|GetHullCenterXcm :self profile))
      (bind vEngineCenterXcm (Class|BPBoatHandlingData|GetEngineCenterXcm :self profile))
      (bind vCenterZcm (Class|BPBoatHandlingData|GetCenterZcm :self profile))
      (bind vFrontPontoonRadiusCm (Class|BPBoatHandlingData|GetFrontPontoonRadiusCm :self profile))
      (bind vRearPontoonRadiusCm (Class|BPBoatHandlingData|GetRearPontoonRadiusCm :self profile))
      (bind vDriveForce (Class|BPBoatHandlingData|GetDriveForce :self profile))
      (bind vLateralDrag (Class|BPBoatHandlingData|GetLateralDrag :self profile))
      (bind vTailWaterDragCoefficient (Class|BPBoatHandlingData|GetTailWaterDragCoefficient :self profile))
      (bind vQuadraticDrag (Class|BPBoatHandlingData|GetQuadraticDrag :self profile))
      (bind vGovernorStartKmh (Class|BPBoatHandlingData|GetGovernorStartKmh :self profile))
      (bind vTargetForwardSpeedKmh (Class|BPBoatHandlingData|GetTargetForwardSpeedKmh :self profile))
      (bind vCruiseThrustScaleAtTarget (Class|BPBoatHandlingData|GetCruiseThrustScaleAtTarget :self profile))
      (bind vOverspeedFadeKmh (Class|BPBoatHandlingData|GetOverspeedFadeKmh :self profile))
      (bind vLaunchPitchTorque (Class|BPBoatHandlingData|GetLaunchPitchTorque :self profile))
      (bind vLaunchPulseSeconds (Class|BPBoatHandlingData|GetLaunchPulseSeconds :self profile))
      (bind vVibrationStartKmh (Class|BPBoatHandlingData|GetVibrationStartKmh :self profile))
      (if (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (and (<= vHullMassKg 1000000000.0) (>= vHullMassKg -1000000000.0)) (<= vEngineMassKg 1000000000.0)) (>= vEngineMassKg -1000000000.0)) (<= vHullCenterXcm 1000000000.0)) (>= vHullCenterXcm -1000000000.0)) (<= vEngineCenterXcm 1000000000.0)) (>= vEngineCenterXcm -1000000000.0)) (<= vCenterZcm 1000000000.0)) (>= vCenterZcm -1000000000.0)) (<= vFrontPontoonRadiusCm 1000000000.0)) (>= vFrontPontoonRadiusCm -1000000000.0)) (<= vRearPontoonRadiusCm 1000000000.0)) (>= vRearPontoonRadiusCm -1000000000.0)) (<= vDriveForce 1000000000.0)) (>= vDriveForce -1000000000.0)) (<= vLateralDrag 1000000000.0)) (>= vLateralDrag -1000000000.0)) (<= vTailWaterDragCoefficient 1000000000.0)) (>= vTailWaterDragCoefficient -1000000000.0)) (<= vQuadraticDrag 1000000000.0)) (>= vQuadraticDrag -1000000000.0)) (<= vGovernorStartKmh 1000000000.0)) (>= vGovernorStartKmh -1000000000.0)) (<= vTargetForwardSpeedKmh 1000000000.0)) (>= vTargetForwardSpeedKmh -1000000000.0)) (<= vCruiseThrustScaleAtTarget 1000000000.0)) (>= vCruiseThrustScaleAtTarget -1000000000.0)) (<= vOverspeedFadeKmh 1000000000.0)) (>= vOverspeedFadeKmh -1000000000.0)) (<= vLaunchPitchTorque 1000000000.0)) (>= vLaunchPitchTorque -1000000000.0)) (<= vLaunchPulseSeconds 1000000000.0)) (>= vLaunchPulseSeconds -1000000000.0)) (<= vVibrationStartKmh 1000000000.0)) (>= vVibrationStartKmh -1000000000.0)) (> vHullMassKg 0.0)) (> vEngineMassKg 0.0)) (> vFrontPontoonRadiusCm 0.0)) (> vRearPontoonRadiusCm 0.0)) (> vDriveForce 0.0)) (> vGovernorStartKmh 0.0)) (> vOverspeedFadeKmh 0.0)) (> vLaunchPulseSeconds 0.0)) (>= vLateralDrag 0.0)) (>= vTailWaterDragCoefficient 0.0)) (>= vQuadraticDrag 0.0)) (>= vLaunchPitchTorque 0.0)) (>= vVibrationStartKmh 0.0)) (>= vCruiseThrustScaleAtTarget 0.0)) (> vTargetForwardSpeedKmh vGovernorStartKmh)) (<= vCruiseThrustScaleAtTarget 1.0)) (<= vVibrationStartKmh vTargetForwardSpeedKmh))
        (Variables|Default|SetHullMassKg vHullMassKg)
        (Variables|Default|SetEngineMassKg vEngineMassKg)
        (Variables|Default|SetHullCenterX vHullCenterXcm)
        (Variables|Default|SetEngineCenterX vEngineCenterXcm)
        (Variables|Default|SetCenterZ vCenterZcm)
        (Variables|Default|SetFrontPontoonRadiusCm vFrontPontoonRadiusCm)
        (Variables|Default|SetRearPontoonRadiusCm vRearPontoonRadiusCm)
        (Variables|Default|SetDriveForce vDriveForce)
        (Variables|Default|SetLateralDrag vLateralDrag)
        (Variables|Default|SetTailWaterDragCoefficient vTailWaterDragCoefficient)
        (Variables|Default|SetQuadraticDrag vQuadraticDrag)
        (Variables|Default|SetGovernorStartKmh vGovernorStartKmh)
        (Variables|Default|SetTargetForwardSpeedKmh vTargetForwardSpeedKmh)
        (Variables|Default|SetCruiseThrustScaleAtTarget vCruiseThrustScaleAtTarget)
        (Variables|Default|SetOverspeedFadeKmh vOverspeedFadeKmh)
        (Variables|Default|SetLaunchPitchTorque vLaunchPitchTorque)
        (Variables|Default|SetLaunchPulseSeconds vLaunchPulseSeconds)
        (Variables|Default|SetVibrationStartKmh vVibrationStartKmh)
        (else
          (Development|PrintString "WARNING Boat handling profile invalid; using Pawn defaults"))))
    (:"Is Not Valid"
      (Development|PrintString "WARNING Boat handling profile missing; using Pawn defaults"))))
