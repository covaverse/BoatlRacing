(fn UpdateDriveState_0 (DeltaSeconds)
  (Variables|Default|SetTestElapsedSeconds (+ (Variables|Default|GetTestElapsedSeconds) DeltaSeconds))
  (bind _returnvalue (Game|GetPlayerController 0))
  (bind _returnvalue_1 0.0)
  (bind _returnvalue_2 (Variables|Default|GetTestElapsedSeconds))
  (bind _returnvalue_3 0.0)
  (bind _testcoastafterseconds (Variables|Default|GetTestCoastAfterSeconds))
  (bind _returnvalue_4 (>= _returnvalue_2 _testcoastafterseconds))
  (bind _returnvalue_5 (> _testcoastafterseconds _returnvalue_1))
  (bind _returnvalue_6 (and _returnvalue_5 _returnvalue_4))
  (bind _returnvalue_7 (<= _testcoastafterseconds _returnvalue_3))
  (bind _returnvalue_8 (or _returnvalue_7 _returnvalue_6))
  (bind _throttle (Variables|Default|GetThrottle))
  (Variables|Default|SetThrottle 0.0)
  (Variables|Default|SetSteeringTargetDegrees 0.0)
  (Variables|Default|SetTrimTargetDegrees 0.0)
  (Variables|Default|SetClutchHeld false)
  (if (Variables|Default|GetUseTestInput)
    (Variables|Default|SetThrottle (select _returnvalue_6 0.0 (Variables|Default|GetTestThrottle)))
    (Variables|Default|SetSteeringTargetDegrees (select _returnvalue_8 (Variables|Default|GetTestSteeringDegrees) 0.0))
    (Variables|Default|SetTrimTargetDegrees (select _returnvalue_8 (Variables|Default|GetTestTrimDegrees) 0.0))
    (Variables|Default|SetClutchHeld (Variables|Default|GetTestClutchHeld))
    (elif (Pawn|IsLocallyControlled self)
      (Variables|Default|SetThrottle (select (Game|Player|IsInputKeyDown _returnvalue "W") 1.0 (select (Game|Player|IsInputKeyDown _returnvalue "S") -0.4 0.0)))
      (Variables|Default|SetSteeringTargetDegrees (select (Game|Player|IsInputKeyDown _returnvalue "D") -18.0 (select (Game|Player|IsInputKeyDown _returnvalue "A") 18.0 0.0)))
      (Variables|Default|SetTrimTargetDegrees (select (Game|Player|IsInputKeyDown _returnvalue "E") 14.0 (select (Game|Player|IsInputKeyDown _returnvalue "Q") -10.0 0.0)))
      (Variables|Default|SetClutchHeld (Game|Player|IsInputKeyDown _returnvalue "SpaceBar"))))
  (if (!= _throttle 0.0)
    (Variables|Default|SetEngineStarted true))
  (Variables|Default|SetEngineRPM (Math|Interpolation|FInterpTo (Variables|Default|GetEngineRPM) (select (Variables|Default|GetEngineStarted) (+ 900.0 (* (select (< _throttle 0.0) (- _throttle) _throttle) (select (Variables|Default|GetClutchHeld) 5600.0 4700.0))) 0.0) DeltaSeconds 2.5))
  (Variables|Default|SetClutchEngagement (Math|Interpolation|FInterpTo (Variables|Default|GetClutchEngagement) (select (Variables|Default|GetClutchHeld) 0.0 1.0) DeltaSeconds (select (Variables|Default|GetClutchHeld) 8.0 4.0)))
  (Variables|Default|SetBoatSpeed (Math|Vector|VectorLength (Transformation|GetComponentVelocity (Variables|Default|GetStaticMesh)))))
